# Ambiente Home Queen — nunca commitar .env com secrets reais

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/homequeen?schema=public"
# Opcional (Hostinger): senha em texto puro, sem %23 na URL
DATABASE_PASSWORD=""

# Sessão / tokens
ADMIN_SESSION_SECRET="gere-um-segredo-longo-aleatorio"
JWT_SECRET="gere-outro-segredo-longo"
NEXTAUTH_SECRET="opcional-compatibilidade"

# Site
NEXT_PUBLIC_SITE_URL="https://www.homequeen.com.br"

# Seed do primeiro admin (só se o banco estiver vazio)
SEED_ADMIN_USERNAME="admin@homequeen"
SEED_ADMIN_EMAIL="admin@homequeen.com.br"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_PASSWORD="defina-senha-forte-aqui"

# E-mail
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="contato@homequeen.com.br"

# Integrações
BLING_CLIENT_ID=""
BLING_CLIENT_SECRET=""
MERCADO_PAGO_ACCESS_TOKEN=""

GOOGLE_ANALYTICS_ID=""
GOOGLE_TAG_MANAGER=""
GOOGLE_SEARCH_CONSOLE=""

CLOUDINARY_URL=""
BCRYPT_ROUNDS="12"

# Cron (Authorization: Bearer <CRON_SECRET>)
# /api/cron/backup | /api/cron/integrity | /api/cron/cleanup
CRON_SECRET=""

# Backup externo — Amazon S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Backblaze B2 (S3-compatible)
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET=""

# Google Drive
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
